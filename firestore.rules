rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function validLecturer(id, data) {
      return data.keys().hasAll(['IDGV', 'Fullname', 'Image', 'SumClass'])
        && data.keys().hasOnly(['IDGV', 'Fullname', 'Image', 'SumClass'])
        && data.IDGV is string && data.IDGV == id
        && data.IDGV.matches('[A-Z0-9][A-Z0-9_-]{0,29}')
        && data.Fullname is string && data.Fullname.size() >= 1 && data.Fullname.size() <= 120
        && data.SumClass is int && data.SumClass >= 0 && data.SumClass <= 9007199254740991
        && data.Image is string && data.Image.size() <= 955760
        && data.Image.matches('data:image/(jpeg|png|gif|webp);base64,[A-Za-z0-9+/]+={0,2}');
    }

    match /QLHocPhan/QuanLy/GiangVien/{lecturerId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validLecturer(lecturerId, request.resource.data);
    }
  }
}
